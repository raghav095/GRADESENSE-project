# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

PORT=3001

# Set to "true" to use the live Gemini/Vertex grader. Leave "false" (or unset)
# to always use the deterministic MockGrader — the app runs fully offline
# with no credentials at all in that mode.
USE_LLM=false

# Option A — Gemini API key (simplest):
GEMINI_API_KEY=

# Option B — Vertex AI via a GCP service account:
# Point this at a service-account JSON file you keep OUTSIDE the repo
# (or anywhere locally, as long as it is not committed — it is gitignored
# by filename pattern *-key.json, but keeping it outside the project folder
# entirely is the safer default).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account.json
